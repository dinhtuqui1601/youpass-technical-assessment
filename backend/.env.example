# YouPass Backend environment configuration.
# Copy to .env and adjust values for local development.

APP_ENV=development
PORT=8080

# MongoDB
MONGO_URI=mongodb://admin:change-me@localhost:27017/?authSource=admin
MONGO_DATABASE=youpass

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# CORS (comma-separated origins, use * to allow all)
ALLOWED_ORIGINS=http://localhost:5173

# Authentication
JWT_ACCESS_SECRET=replace-with-secure-secret
JWT_ACCESS_TTL=15m
JWT_ISSUER=youpass
JWT_AUDIENCE=youpass-web

REFRESH_TOKEN_TTL=168h
REFRESH_GRACE_PERIOD=30s

# Refresh-token cookie
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Rate limiting (requests per window)
LOGIN_RATE_LIMIT=10
REFRESH_RATE_LIMIT=30
RATE_LIMIT_WINDOW=1m

# View worker
VIEW_WORKER_CONCURRENCY=5
