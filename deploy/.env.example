# YouPass Deployment environment configuration.
# Copy to .env and adjust values. Never commit real credentials.

# Nginx reverse proxy (the public entry point)
NGINX_PORT=8080

# MongoDB
MONGO_PORT=27017
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=change-me
MONGO_DATABASE=youpass

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Backend CORS (frontend origin, comma-separated)
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Authentication (change in production)
JWT_ACCESS_SECRET=replace-with-secure-secret
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=168h
REFRESH_GRACE_PERIOD=30s

# Refresh-token cookie
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# View worker
VIEW_WORKER_CONCURRENCY=5
